# Copy to ~/.config/eps-dashboard.env (NOT this repo) and fill in.
# Read by the eps-dashboard.service systemd user unit.

# --- Required ---
# NOTE: do NOT set NODE_ENV here. systemd would pass it to `npm install`,
# which would then skip devDependencies (where @tailwindcss/postcss +
# typescript live). `next build` already sets NODE_ENV=production for
# the compiled artifact and `next start` defaults to production.
PORT=3010

# Long random secret (≥16 chars). The /tasks/<N>/edit route + save server
# action gate on a cookie matching this value. Visit /sign-in?next=<path>
# once, paste this secret, and the dashboard sets the eps-editor cookie
# for 30 days.
#
# Generate with:  openssl rand -base64 32
EDITOR_SECRET=__paste_long_random_secret_here__

# --- Optional ---
# Override repo location if dashboard lives somewhere unusual:
# EPS_REPO_ROOT=/home/thomasjiralerspong/explore-persona-space
