__pycache__/
*.pyc
*.pyo
.env
.env.*
.env.local
.ev
*.egg-info/
dist/
build/
.eggs/
# data/ is ignored EXCEPT the canonical persona pool (#483) and the
# assistant_axis role/instruction pool (#368): committed pool / matrix / meta
# JSONs live there. `data/*` (not `data/`) because git cannot re-include
# files under an excluded directory — the negation only works when the
# parent dir itself is not excluded.
data/*
!data/canonical_persona_pool/
!data/assistant_axis/
# issue #923 Phase-0 committed inputs (probe pools, folds, store pins)
!data/issue923/
outputs/
*.output
.pytest_cache/
wandb/

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.idea/
.vscode/

# ArXiv papers (downloaded by MCP server)
.arxiv-papers/

# External repos: ignore nested .git dirs but track the code
external/agentic-backdoor/.git/
external/training-against-misalignment/.git/
# Ignore heavy/generated dirs in external repos
external/agentic-backdoor/logs/
external/agentic-backdoor/outputs/
external/agentic-backdoor/wandb/
external/agentic-backdoor/.hf_cache/
external/agentic-backdoor/.triton-cache/
external/training-against-misalignment/logs/
# Large data files in external repos (reference code only, not data)
external/training-against-misalignment/data7/
external/training-against-misalignment/data8/
external/training-against-misalignment/midtrain/data/
external/training-against-misalignment/midtrain/posttrain/*/data/
external/training-against-misalignment/vectors/

# Large binary files (activations, centroids, model weights)
*.pt
*.pth
*.safetensors
*.bin
*.npz
# Committed test fixtures are exempt (small, <1 MB; e.g. the #1335
# GCV-degeneracy real-slice fixture)
!tests/fixtures/*.npz

# Secrets
*.key
*.pem
credentials*

# pods.conf flock lockfile (task #821) — belt-and-braces gitignore. The
# lockfile lives at scripts/.pods.conf.lock alongside the tracked seed;
# ``locked_pods_conf`` recreates it with O_CREAT on every acquire, so its
# deletion by ``git clean -fdx`` is harmless — the ignore just spares
# ``git status`` a noise line for a file no reader/writer ever tracks.
scripts/.pods.conf.lock

# Claude Code transient state — not part of project history
.claude/cache/
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/plans/issue-*.md

# Local scratch / dev artifacts
.playwright-mcp/
logs/
errors.log

# Dashboard anchor-comment stores for living docs/logs (preserve-commit-status:
# doc/log comments stay local, never committed). The docs categorization now
# surfaces docs/mentor_updates/*.md and docs/ideas/*.md as commentable, so their
# .comments/ stores need covering too — a broad glob catches every doc subtree.
**/.comments/

# Per-run completion sentinels (#598) — the SLURM finalize rsync lands them
# inside the working tree under eval_results/issue_<N>/slurm-<jobid>/; they
# are runtime noise, never committed (the git artifact check needs >=1
# TRACKED file under eval_results/issue_<N>/ — the eval JSONs — not this).
.completion-sentinel.json

# pod_config --sync audit trail (#831) — normally lands next to the LIVE
# pods.conf at <git-common-dir>/eps/, but the read-only-fs / seed-fallback
# resolution can place it inside the working tree at scripts/sync_audit.log;
# runtime noise, never committed.
scripts/sync_audit.log

# Embedded git repo (Overleaf paper) — tracked in its own remote
overleaf_paper/
.vercel

# Issue #763 smoke-scope trees (EPM_ISSUE763_SMOKE_SCOPE=1): the dispatcher
# --smoke relocates every WRITE-target dir under a sibling smoke_scope/ so
# mock artifacts never land at canonical production paths (review r1 C1(iii)).
**/smoke_scope/
