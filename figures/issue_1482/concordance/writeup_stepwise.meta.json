{
  "what_is_plotted": "Forward-stepwise concordance. Round 0 conditions on nothing; each later round adds the previous round's winner (max |c - 0.5|) to the control set, re-stratifies by coarsened exact matching over the control set, and re-scores every remaining candidate.",
  "statistic": "D_{y|x} = (C - Dis) / (n_pairs - T_x);  c = (D + 1) / 2",
  "n_rows": 120716,
  "selection_rule": "max |c - 0.5| among remaining candidates; the winner then retires every candidate with |Spearman| >= 0.9 to it (the same cut the #1482 Shapley block declustering uses), because decile stratification leaves residual within-stratum variation and a near-duplicate would otherwise re-win on the SAME construct",
  "binning_rule": "bins per control = clip(round(400 ** (1/k)), 2, 10); a control with <= bins distinct values uses its own levels",
  "stop_rules": {
    "effect": "best remaining |c - 0.5| < 0.02",
    "pairs": "retained-pair fraction < 0.005",
    "max_rounds": 6
  },
  "excluded": [
    "matryoshka tier \u2014 a different dictionary/panel, so it has no value to stratify the layer-19 battery ON and cannot enter a stepwise selection over it",
    "dense_latent_flag \u2014 a threshold on `activity`, already present continuously"
  ],
